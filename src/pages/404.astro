---
import Base from "../layouts/Base.astro";
---

<Base locale="en" langHref="/" title="PAGE NOT FOUND — The Dev Saga" description="This page fell into the multiverse rift. Return to page 1.">
  <section class="px-4 py-20 sm:px-6 sm:py-28">
    <div class="panel-ink mx-auto max-w-2xl p-8 text-center sm:p-14">
      <p class="font-display text-[clamp(4rem,12vw,8rem)] leading-none tracking-wide rotate-[-2deg]">404!</p>
      <p class="caption-box mx-auto mt-5 max-w-sm bg-panel px-4 py-2 text-sm font-semibold sm:text-base">
        THIS PAGE WAS LOST IN THE MULTIVERSE RIFT.
      </p>
      <p class="mx-auto mt-5 max-w-md leading-relaxed text-ink/85">
        The panel you are looking for was never inked — or it was erased in a retcon.
        Either way, the main story continues on page 1.
      </p>
      <a href="/" class="btn-ink-solid mt-8 px-7 py-3 text-xl hover:-translate-y-0.5 hover:shadow-ink">Back to page 1</a>
    </div>
  </section>
</Base>
