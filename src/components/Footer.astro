---
import { getDict, type Locale } from "../i18n/ui";

interface Props {
  locale?: Locale;
  langHref?: string;
}
const { locale = "en", langHref } = Astro.props;
const t = getDict(locale);
const onId = locale === "id";
const homePath = onId ? "/id/" : "/";
const isHome = Astro.url.pathname === homePath;
const backHref = langHref ?? (isHome ? "#top" : homePath + "#top");
const year = new Date().getFullYear();
---

<footer class="mt-4 border-t-[4px] border-ink bg-ink text-paper">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div>
        <p class="font-display text-6xl leading-none tracking-wide sm:text-7xl">{t.footer.end}<span class="align-top text-4xl">?</span></p>
        <p class="caption-box mt-3 inline-block bg-paper px-3 py-1 text-xs font-semibold text-ink sm:text-sm">
          {t.footer.forNow}
        </p>
      </div>
      <a
        href={backHref}
        class="inline-flex items-center gap-2 border-[3px] border-paper bg-paper px-5 py-2.5 font-display text-lg tracking-wide text-ink uppercase shadow-[4px_4px_0_0_var(--color-paper)] transition-transform duration-200 hover:-translate-y-0.5"
      >
        {t.footer.back}
      </a>
    </div>

    <div class="mt-12 h-[2px] w-full bg-paper/25" aria-hidden="true"></div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 font-caption text-xs font-medium tracking-[0.16em] uppercase">
      <p>{t.footer.written}</p>
      <p>{t.footer.printed}</p>
      <p>© {year} {t.footer.rights}</p>
    </div>
    <p class="mt-4 max-w-2xl font-caption text-[11px] leading-relaxed tracking-[0.1em] text-paper/55 uppercase">
      {t.footer.demoNotice}
    </p>
  </div>
</footer>
