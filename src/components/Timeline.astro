---
import SectionHead from "./SectionHead.astro";
import { getDict, type Locale } from "../i18n/ui";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const t = getDict(locale);
const chapters = t.arc.chapters;
---

<section id="arc" class="px-4 pt-16 sm:px-6 sm:pt-24">
  <div class="mx-auto max-w-7xl">
    <SectionHead chapter={t.arc.chapter} title={t.arc.title} note={t.arc.note} />
  </div>

  <div class="mx-auto max-w-7xl">
    <div class="reveal flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 [scrollbar-width:thin] lg:grid lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr_auto_1.15fr] lg:items-stretch lg:overflow-visible">
      {
        chapters.map((c, i) => (
          <>
            <article
              class:list={[
                "reveal w-[240px] shrink-0 snap-start border-[3px] border-ink bg-panel p-5 shadow-ink lg:w-auto",
                i % 2 === 1 && "lg:mt-6",
                i === 2 && "lg:mt-2",
              ]}
              style={`--reveal-delay:${i * 110}ms; --tilt:${i % 2 ? "0.8deg" : "-0.8deg"};`}
            >
              <div class="flex items-center justify-between gap-2">
                <span class="caption-box bg-ink px-2 py-0.5 text-[11px] font-semibold text-paper">{c.tag}</span>
                <span class="font-caption text-xs font-semibold tracking-[0.14em] text-ink/60">{c.years}</span>
              </div>
              <h3 class="mt-3 font-display text-3xl tracking-wide">{c.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/85">{c.blurb}</p>
            </article>
            {i < chapters.length && (
              <svg
                viewBox="0 0 40 24"
                class="reveal mx-auto hidden w-10 self-center fill-ink lg:block"
                aria-hidden="true"
                style={`--reveal-delay:${i * 110 + 60}ms;`}
              >
                <path d="M2 8 H22 V2 L38 12 L22 22 V16 H2 Z" />
              </svg>
            )}
          </>
        ))
      }

      <!-- NOW panel -->
      <article class="reveal relative w-[240px] shrink-0 snap-start overflow-hidden border-[3px] border-ink bg-ink p-5 text-paper shadow-ink lg:w-auto" style="--reveal-delay:480ms">
        <div class="halftone pointer-events-none absolute -top-8 -right-8 size-36 text-paper opacity-15" aria-hidden="true"></div>
        <div class="flex items-center justify-between gap-2">
          <span class="caption-box bg-paper px-2 py-0.5 text-[11px] font-semibold text-ink">{t.arc.next.tag}</span>
          <span class="font-caption text-xs font-semibold tracking-[0.14em] text-paper/70">NOW</span>
        </div>
        <h3 class="mt-3 font-display text-3xl tracking-wide">{t.arc.next.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-paper/85">
          {t.arc.next.text}
          <a href={locale === "id" ? "/id/#signal" : "#signal"} class="mt-3 inline-block font-display text-lg tracking-wider underline decoration-[3px] underline-offset-4 hover:bg-paper hover:text-ink">
            {t.arc.next.cta}
          </a>
        </p>
      </article>
    </div>
  </div>
</section>
